    users ||--o{ user_sessions : "maintains"
    users ||--o{ face_encodings : "registers"
    users ||--o{ access_logs : "records"
    users ||--o{ lecturer_grade_otps : "receives"

    semesters ||--o| semester_configs : "configured_by"
    semesters ||--o{ holidays : "includes"
    semesters ||--o{ class_sections : "contains"
    courses ||--o{ class_sections : "offered_as"

    rooms ||--o{ room_wifi_access_points : "located_at"
    wifi_access_points ||--o{ room_wifi_access_points : "covers"

    class_sections ||--o{ teaching_assignments : "assigned_to"
    users ||--o{ teaching_assignments : "teaches"

    class_sections ||--o{ enrollments : "enrolled_in"
    users ||--o{ enrollments : "studies"

    class_sections ||--o{ timetable_slots : "schedules"
    slot_types ||--o{ timetable_slots : "defines_time"
    rooms ||--o{ timetable_slots : "hosted_in"
    users ||--o{ timetable_slots : "lectured_by"

