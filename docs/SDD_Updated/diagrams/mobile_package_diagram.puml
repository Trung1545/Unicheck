@startuml Mobile_Package_Diagram_UniCheck
title Mobile Client Package Diagram - UniCheck (Flutter 3.27, Dart 3.6, GetX)
skinparam packageStyle rectangle
skinparam backgroundColor #FFFFFF

package "UniCheck Mobile App (lib/)" {
  package "app" {
    [main.dart]
    [app.dart]
    package "routes" {
      [AppRoutes (LOGIN, HOME, SCHEDULE, ENROLLMENT, CHECKIN, HISTORY, PROFILE)]
      [AppPages]
    }
  }

  package "views (Student Focused)" {
    [login_view.dart]
    [home_view.dart]
    [schedule_view.dart]
    [face_enrollment_view.dart (3-Step Head Pose Camera)]
    [face_checkin_view.dart (Realtime Camera & Geolocation)]
    [attendance_history_view.dart]
    [profile_view.dart]
  }

  package "controllers (GetxController)" {
    [login_controller.dart]
    [home_controller.dart]
    [schedule_controller.dart]
    [face_enrollment_controller.dart]
    [face_checkin_controller.dart]
    [attendance_history_controller.dart]
    [profile_controller.dart]
  }

  package "bindings (GetX Bindings)" {
    [login_binding.dart]
    [home_binding.dart]
    [schedule_binding.dart]
    [face_enrollment_binding.dart]
    [face_checkin_binding.dart]
    [profile_binding.dart]
  }

  package "services" {
    package "ai_vision" {
      [head_pose_evaluator.dart (Euler angles: Yaw, Pitch)]
      [camera_stream_manager.dart]
      [google_mlkit_face_detector.dart]
    }
    package "sensors_network" {
      [location_service.dart (GPS Geofence)]
      [network_info_service.dart (BSSID / WiFi)]
    }
    package "storage" {
      [secure_storage_service.dart (FlutterSecureStorage: JWT)]
      [cache_service.dart]
    }
  }

  package "api (Dio 5.7 HTTP Client)" {
    [api_client.dart (Interceptors, Auth Header, Refresh Token)]
    [auth_api.dart]
    [schedule_api.dart]
    [attendance_api.dart]
    [student_api.dart]
  }

  package "models" {
    [user_model.dart]
    [schedule_model.dart]
    [attendance_record_model.dart]
    [attendance_session_model.dart]
  }
}

views ..> controllers : observe & action
bindings ..> controllers : inject dependencies
controllers ..> services : use device sensors & storage
controllers ..> api : execute REST requests
api ..> models : deserialize JSON
@enduml
