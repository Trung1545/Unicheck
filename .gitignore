# ==============================================================================
# UniCheck - Root .gitignore for Polyglot Monorepo
# Includes: Spring Boot (Java), React Vite (Node), Flutter (Dart), Flask (Python)
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment & Sensitive Information
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
*.jks
firebase-service-account*.json

# ------------------------------------------------------------------------------
# Operating Systems & General IDEs
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*.iml
*.iws
*.ipr
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------------------------
# 1. Backend: Java & Spring Boot (Maven)
# ------------------------------------------------------------------------------
backend/target/
backend/*.log
backend/logs/
*.class
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
.mvn/wrapper/maven-wrapper.jar

# ------------------------------------------------------------------------------
# 2. Frontend: React + Vite + TypeScript (Node.js)
# ------------------------------------------------------------------------------
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
frontend/.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# 3. Mobile: Flutter + Dart (Android & iOS)
# ------------------------------------------------------------------------------
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.packages
mobile/build/
mobile/.pub-cache/
mobile/.pub/
mobile/*.iml
mobile/android/.gradle/
mobile/android/captures/
mobile/android/gradlew
mobile/android/gradlew.bat
mobile/android/local.properties
mobile/android/**/build/
mobile/ios/.generated/
mobile/ios/Pods/
mobile/ios/.symlinks/
mobile/ios/Flutter/Generated.xcconfig
mobile/ios/Flutter/app.framework
mobile/ios/Flutter/Flutter.framework
mobile/ios/Flutter/Flutter.podspec

# ------------------------------------------------------------------------------
# 4. AI Service: Python + Flask (OpenCV)
# ------------------------------------------------------------------------------
ai-service/__pycache__/
ai-service/*/__pycache__/
ai-service/*/*/__pycache__/
ai-service/venv/
ai-service/env/
ai-service/.venv/
ai-service/.pytest_cache/
ai-service/.coverage
ai-service/htmlcov/
*.py[cod]
*$py.class
*.so
.Python

# ------------------------------------------------------------------------------
# Docker & Scratch Directories
# ------------------------------------------------------------------------------
docker-volumes/
scratch/
temp_docx/
stitch-skills-main/
