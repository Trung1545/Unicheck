# ==============================================================================
# UniCheck - Environment Configuration Template
# ==============================================================================

# Database (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=unicheck_db
DB_USER=unicheck_user
DB_PASSWORD=unicheck_secret_password

# Redis Cache & Session
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Spring Boot Backend
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Web Frontend (React + Nginx)
FRONTEND_PORT=80

# JWT Security Configuration
JWT_SECRET=your_secure_random_jwt_secret_key_minimum_256_bits_required
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# AI Microservice (Python Flask)
AI_SERVICE_URL=http://ai-service:5000
AI_SERVICE_PORT=5000

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Firebase Cloud Messaging (FCM)
FIREBASE_CONFIG_PATH=/app/config/firebase-service-account.json

# Public Gateway (ngrok)
NGROK_AUTHTOKEN=your_ngrok_token
NGROK_DOMAIN=
