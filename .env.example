# ==============================================================================
# UniCheck - Environment Configuration Template
# ==============================================================================

# Database (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=unicheck_db
DB_USER=unicheck_user
DB_PASSWORD=unicheck_secret_password

# Redis Cache & Session
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Spring Boot Backend
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# JWT Security Configuration
JWT_SECRET=4c9a58b29f7e1b3d5c7a9e0f2b4d6e8a0c2e4f6a8b0d2e4f6a8b0d2e4f6a8b0d
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# AI Microservice (Python Flask)
AI_SERVICE_URL=http://ai-service:5000
AI_SERVICE_PORT=5000

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Firebase Cloud Messaging (FCM)
FIREBASE_CONFIG_PATH=/app/config/firebase-service-account.json

# Public Gateway (ngrok)
NGROK_AUTHTOKEN=your_ngrok_token
NGROK_DOMAIN=
